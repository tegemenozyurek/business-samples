rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /website-form/{docId} {
      allow create: if isValidWebsiteForm(request.resource.data);
      allow read: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    function isValidWebsiteForm(data) {
      return data.keys().hasAll(['name', 'email', 'serviceType', 'message', 'createdAt'])
        && data.keys().hasOnly(['name', 'company', 'email', 'phone', 'serviceType', 'message', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.company is string
        && data.company.size() <= 100
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.phone is string
        && data.phone.size() <= 30
        && data.serviceType is string
        && data.serviceType.size() > 0
        && data.serviceType.size() <= 100
        && data.message is string
        && data.message.size() > 0
        && data.message.size() <= 2000
        && data.createdAt == request.time;
    }
  }
}
